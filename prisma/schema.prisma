generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
  previewFeatures = ["views"]
}

datasource db {
  provider = "mysql"
}

model Guild {
  id            String @id
  name          String?
  rolls_channel String?
  insults       Boolean @default(true)

  users            User[]
  advancedSheetSet AdvancedSheetSet[]
  sheetSets        RpgSheetSet[]
  sheetMaps        SheetMap[]
}

model User {
  id      String
  ficha   String?
  guildId String
  guild   Guild @relation(fields: [guildId], references: [id])

  @@id([id, guildId])
}

model RpgSheetSet {
  name     String
  cell     String
  alias    String?
  dice     String?
  action  RpgSheetAction @default(get)

  guildId  String
  guild    Guild @relation(fields: [guildId],references: [id])

  @@id([name, guildId])
}

enum RpgSheetAction {
  get
  set
}

model SheetMap  {
  name     String
  cell     String
  guildId  String
  guild    Guild @relation(fields: [guildId],references: [id])
  @@id([name, guildId])
}

model AdvancedSheetSet{
  name      String
  alias     String?
  operation String

  guildId  String
  guild    Guild @relation(fields: [guildId],references: [id])

  @@id([name, guildId])
}

view VSheetSet {
  name      String
  guildId   String
  cell      String?
  alias     String?
  dice      String?
  action    RpgSheetAction?
  operation String?
}
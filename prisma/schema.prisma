generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
  previewFeatures = ["views"]
}

datasource db {
  provider = "mysql"
}

model Guild {
  id            String @id
  name          String?
  rolls_channel String?
  insults       Boolean @default(true)

  users            User[]
  sheetSets        RpgSheetSet[]
  sheetMaps        SheetMap[]
  spells           Spell[]
  rpgAttributes    GuildRpgAttribute[]
}

model Spell {
  id      Int     @id @default(autoincrement())
  command String  @db.VarChar(25)
  alias   String  @db.VarChar(50)
  effect  String? @db.VarChar(50)
  form    String  @db.VarChar(100)
  extra   String? @db.VarChar(50)
  guildId String  @db.VarChar(191)
  guild   Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([command, guildId])
  @@map("Spells")
}

model GuildRpgAttribute {
  id              Int                @id @default(autoincrement())
  name            String             @db.VarChar(25)
  guildId         String             @db.VarChar(191)
  guild           Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userAttributes  UserRpgAttribute[]

  @@unique([name, guildId])
}

model UserRpgAttribute {
  id          Int               @id @default(autoincrement())
  userId      String            @db.VarChar(191)
  value       String            @db.VarChar(15)
  bonus       String?           @db.VarChar(15)
  attributeId Int
  attribute   GuildRpgAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([userId, attributeId])
}

model User {
  id      String
  ficha   String?
  guildId String
  guild   Guild @relation(fields: [guildId], references: [id])

  @@id([id, guildId])
}

model RpgSheetSet {
  name     String
  cell     String
  alias    String?
  dice     String?
  action  RpgSheetAction @default(get)

  guildId  String
  guild    Guild @relation(fields: [guildId],references: [id])

  @@id([name, guildId])
}

enum RpgSheetAction {
  get
  set
}

model SheetMap  {
  name     String
  cell     String
  guildId  String
  guild    Guild @relation(fields: [guildId],references: [id])
  @@id([name, guildId])
}

view VSheetSet {
  name      String
  guildId   String
  cell      String?
  alias     String?
  dice      String?
  action    RpgSheetAction?
  operation String?
}